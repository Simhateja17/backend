    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $json.bot_token }}/sendChatAction",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, action: 'typing' }) }}",
        "options": {}
      },
      "name": "Typing…",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        80
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.ts + '.' + $json.raw }}",
        "dataPropertyName": "signature",
        "secret": "={{ $json.secret }}",
        "encoding": "hex"
      },
      "name": "Sign",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.backend_url }}/channels/telegram/{{ $json.bot_kind }}/cartisan",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Cartisan-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-Cartisan-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.raw }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Cartisan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Cartisan returns the exact Bot API calls to make; n8n only delivers them.\nconst token = $('Sign').first().json.bot_token;\nconst out = [];\nfor (const item of $input.all()) {\n  for (const m of item.json.messages || []) out.push({ json: { ...m, bot_token: token } });\n}\nreturn out;"
      },
      "name": "One item per Bot API call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $json.bot_token }}/{{ $json.method }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        300
      ],
      "onError": "continueRegularOutput"
    }
