{
  "name": "Cartisan Telegram — relay",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 15
            }
          ]
        }
      },
      "name": "Every 15s",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "Relay context-0",
              "name": "shopping_token",
              "value": "SHOPPING-BOT-TOKEN",
              "type": "string"
            },
            {
              "id": "Relay context-1",
              "name": "merchant_token",
              "value": "MERCHANT-BOT-TOKEN",
              "type": "string"
            },
            {
              "id": "Relay context-2",
              "name": "backend_url",
              "value": "https://YOUR-BACKEND",
              "type": "string"
            },
            {
              "id": "Relay context-3",
              "name": "secret",
              "value": "SAME-AS-TELEGRAM_CHANNEL_SECRET",
              "type": "string"
            },
            {
              "id": "Relay context-4",
              "name": "raw",
              "value": "{}",
              "type": "string"
            },
            {
              "id": "Relay context-5",
              "name": "ts",
              "value": "={{ Math.floor(Date.now() / 1000).toString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Relay context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.ts + '.' + $json.raw }}",
        "dataPropertyName": "signature",
        "secret": "={{ $json.secret }}",
        "encoding": "hex"
      },
      "name": "Sign",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.backend_url }}/channels/telegram/relay",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Cartisan-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-Cartisan-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.raw }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Cartisan relay",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Sign').first().json;\nconst out = [];\nfor (const item of $input.all()) {\n  for (const d of item.json.deliveries || []) {\n    out.push({ json: { method: d.method, body: d.body,\n      bot_token: d.bot_kind === 'merchant' ? ctx.merchant_token : ctx.shopping_token } });\n  }\n}\nreturn out;"
      },
      "name": "One item per Bot API call",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $json.bot_token }}/{{ $json.method }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 15s": {
      "main": [
        [
          {
            "node": "Relay context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Relay context": {
      "main": [
        [
          {
            "node": "Sign",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign": {
      "main": [
        [
          {
            "node": "Cartisan relay",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cartisan relay": {
      "main": [
        [
          {
            "node": "One item per Bot API call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per Bot API call": {
      "main": [
        [
          {
            "node": "Send to Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}