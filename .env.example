# Copy this file to .env and replace the placeholders.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_WORKSPACE_ID=wrkspc_...
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=low
MERCHANT_REQUIRE_HOST_APPROVAL=1
# Supabase Dashboard -> Connect -> Transaction pooler. Keep this server-side only.
# Use sslmode=require and URL-encode special characters in the password.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Supabase Dashboard -> Project Settings -> API. Used to verify access tokens.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Telegram channel via n8n (see n8n/README.md)
TELEGRAM_CHANNEL_SECRET=
TELEGRAM_LINK_BASE_URL=http://localhost:3000
CARTISAN_MERCHANT_ID=cartisan
TELEGRAM_REQUIRE_SECOND_APPROVER=1

# Cognee memory (see ../COGNEE_BUILD_PLAN.md). Off by default; memory still works
# locally (facts, brief, suggestions) and syncs to Cognee Cloud once enabled.
COGNEE_ENABLED=0
COGNEE_SERVICE_URL=https://your-tenant.aws.cognee.ai
COGNEE_API_KEY=
COGNEE_DAILY_CALL_CAP=2000
COGNEE_SUBJECT_DAILY_CAP=40
# HMAC key for Cognee dataset names and the guest cookie. Set a long random value.
CARTISAN_MEMORY_SECRET=

# Cart recovery email (Resend). Off until both are set; on-site offers work without it.
RESEND_API_KEY=
RESEND_FROM="Cartisan <offers@your-verified-domain.com>"
CARTISAN_SITE_URL=http://localhost:3000
CARTISAN_API_URL=http://127.0.0.1:8000
# Run memory sync + cart recovery every CARTISAN_JOB_INTERVAL_SECONDS in-process.
CARTISAN_BACKGROUND_JOBS=0
CARTISAN_JOB_INTERVAL_SECONDS=300
# Simulated Paytm gateway: pay links open ${FRONTEND_URL}/pay?link=...
FRONTEND_URL=http://localhost:3000
PAYMENT_SIM_SECRET=change-me
